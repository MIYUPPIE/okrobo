<?xml version="1.0"?>
<!-- The studio's 4-DOF arm, described in the URDF subset of
     contracts/pack/v0. Dimensions and limits match engine/src/arm.hpp; a
     parity test keeps them in step. -->
<robot name="okrobo_arm">
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.08" length="0.12"/></geometry>
    </visual>
  </link>
  <link name="shoulder_link"/>
  <link name="elbow_link"/>
  <link name="wrist_link"/>
  <link name="tool_link"/>

  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265" upper="3.14159265" velocity="1.57079633"/>
  </joint>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0.22 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.17453293" upper="1.74532925" velocity="1.57079633"/>
  </joint>

  <joint name="elbow_pitch" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09439510" upper="2.09439510" velocity="1.57079633"/>
  </joint>

  <joint name="wrist_pitch" type="revolute">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079633" upper="1.57079633" velocity="1.57079633"/>
  </joint>
</robot>
