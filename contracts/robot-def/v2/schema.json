{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "okrobo:robot-def:v2",
  "title": "OKROBO Robot Definition v2",
  "description": "v1 plus one new optional body field, features: an ordered, additive record of the CAD-kernel operations (see apps/studio/src/cad/kernel.ts) that produced a cad_mesh body's own baked vertices/faces -- layered on top of, not replacing, that baked data (see docs/decisions/cad-kernel-feature-tree-data-model.md). Still not itself a live, re-editable, recomputing feature tree -- that is CAD Kernel Phase 7.2/7.3's job; this version only persists the record. Otherwise identical to v1: a structural, backend-agnostic description of an arbitrary robot -- bodies, joints, actuators, sensors. Purely a data document -- it carries no simulation behavior of its own. Units: meters, kilograms, radians, seconds. Rotation is roll-pitch-yaw (intrinsic XYZ Euler, radians), matching the rpy convention URDF (and this repo's packs/core/robots/arm.urdf) already uses. The kinematic tree is defined entirely by joints[] edges, not a body.parent field: a body with no incoming joint edge is a root, and rigid attachment is expressed as a fixed joint rather than a second hierarchy mechanism.",
  "type": "object",
  "required": ["id", "name", "bodies"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Stable identifier, kebab-case (matches contracts/pack/v0's id convention)."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "root_placement": {
      "$ref": "#/definitions/transform",
      "description": "Where the root body sits in world space. Default: identity."
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/body" }
    },
    "joints": {
      "type": "array",
      "items": { "$ref": "#/definitions/joint" }
    },
    "actuators": {
      "type": "array",
      "items": { "$ref": "#/definitions/actuator" }
    },
    "sensors": {
      "type": "array",
      "items": { "$ref": "#/definitions/sensor" }
    }
  },
  "definitions": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/definitions/vec3" },
        "rotation_rpy": { "$ref": "#/definitions/vec3", "description": "roll, pitch, yaw, radians" }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "size"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "box" },
            "size": { "$ref": "#/definitions/vec3", "description": "full extents x,y,z, each > 0" }
          }
        },
        {
          "type": "object",
          "required": ["type", "radius"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "sphere" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "radius", "length"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "cylinder" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "length": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "radius", "length"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "capsule" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "length": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "radius", "length"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "cone" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "length": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "size"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "plane" },
            "size": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0 },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "mesh" },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "pack-relative path, resolved and loaded later (Phase 3+); not opened in v0/v1"
            },
            "scale": { "$ref": "#/definitions/vec3", "description": "default [1,1,1]" }
          }
        },
        {
          "type": "object",
          "required": ["type", "vertices", "faces"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "cad_mesh" },
            "vertices": {
              "type": "array",
              "items": { "type": "number" },
              "description": "Flat [x0,y0,z0,x1,y1,z1,...] triples, length a multiple of 3, in this body's own frame. Baked output of the CAD kernel (see docs/decisions/cad-kernel-foundation.md) -- not a live, re-editable feature tree."
            },
            "faces": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Flat triangulated vertex-index triples [a0,b0,c0,a1,b1,c1,...], length a multiple of 3, every index < vertices.length/3."
            }
          }
        }
      ]
    },
    "profile": {
      "description": "A 2D sketch profile, as authored in Build mode's CAD tools -- see apps/studio/src/cad/kernel.ts's own Profile type.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rectangle" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "radius"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "circle" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "cad_pick": {
      "type": "object",
      "required": ["source_step", "local_index", "point"],
      "additionalProperties": false,
      "description": "A picked edge or face reference. source_step/local_index are forward-looking and unused this phase -- reserved for CAD Kernel Phase 7.2's real topological identity (OpenCascade's own Modified/Generated/IsDeleted history, propagated step to step). point is the geometric descriptor every picking tool already computes today (see docs/decisions/cad-kernel-fillet-chamfer.md and cad-kernel-shell-draft.md).",
      "properties": {
        "source_step": { "type": "integer", "minimum": 0, "description": "Index into this body's own features[] list of the step that first exposed this edge/face." },
        "local_index": { "type": "integer", "minimum": 0, "description": "Index into that step's own live edges/faces at the moment it was picked." },
        "point": { "$ref": "#/definitions/vec3" }
      }
    },
    "fillet_chamfer_pick": {
      "type": "object",
      "required": ["source_step", "local_index", "point", "operation", "value"],
      "additionalProperties": false,
      "properties": {
        "source_step": { "type": "integer", "minimum": 0 },
        "local_index": { "type": "integer", "minimum": 0 },
        "point": { "$ref": "#/definitions/vec3" },
        "operation": { "enum": ["fillet", "chamfer"] },
        "value": { "type": "number", "exclusiveMinimum": 0, "description": "Fillet radius or chamfer distance." }
      }
    },
    "boss_operation": {
      "description": "A fresh-shape-creating operation -- Extrude/Revolve/Boundary. Mirrors apps/studio/src/cad/kernel.ts's own BossOperation type exactly, including its 'loft' discriminant for what Build mode's own toolbar calls Boundary.",
      "oneOf": [
        {
          "type": "object",
          "required": ["operation", "profile", "depth"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "extrude" },
            "profile": { "$ref": "#/definitions/profile" },
            "depth": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["operation", "profile", "offset", "angle_deg"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "revolve" },
            "profile": { "$ref": "#/definitions/profile" },
            "offset": { "type": "number" },
            "angle_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 }
          }
        },
        {
          "type": "object",
          "required": ["operation", "start_profile", "end_profile", "height"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "loft" },
            "start_profile": { "$ref": "#/definitions/profile" },
            "end_profile": { "$ref": "#/definitions/profile" },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "feature": {
      "description": "One step in a cad_mesh body's own construction history (CAD Kernel Phase 7.1, see docs/decisions/cad-kernel-feature-tree-data-model.md). A body's features[] is additive metadata layered on top of its baked visual/collision vertices/faces, never a replacement for them -- not itself editable or replayed yet (Phase 7.3's job). The first entry is always a root (Extrude/Revolve/Boundary, or a plain box/cylinder primitive a modifier tool was applied to directly); every later entry is a modifier applied to the previous entry's own result.",
      "oneOf": [
        { "$ref": "#/definitions/boss_operation" },
        {
          "type": "object",
          "required": ["operation", "size"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "box" },
            "size": { "$ref": "#/definitions/vec3" }
          }
        },
        {
          "type": "object",
          "required": ["operation", "radius", "length"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "cylinder" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "length": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["operation", "tool", "position"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "cut" },
            "tool": { "$ref": "#/definitions/boss_operation" },
            "position": { "$ref": "#/definitions/vec3" }
          }
        },
        {
          "type": "object",
          "required": ["operation", "picks"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "fillet_chamfer" },
            "picks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/fillet_chamfer_pick" } }
          }
        },
        {
          "type": "object",
          "required": ["operation", "picks", "thickness"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "shell" },
            "picks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cad_pick" } },
            "thickness": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["operation", "picks", "angle_deg"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "draft" },
            "picks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cad_pick" } },
            "angle_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 }
          }
        }
      ]
    },
    "body": {
      "type": "object",
      "required": ["id", "name", "mass", "inertia"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "transform": {
          "$ref": "#/definitions/transform",
          "description": "geometry offset within this body's own frame; default identity"
        },
        "visual": { "$ref": "#/definitions/geometry" },
        "collision": { "$ref": "#/definitions/geometry" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature" },
          "description": "Ordered CAD-kernel construction history for a cad_mesh body (CAD Kernel Phase 7.1+). Absent or empty means a hand-authored primitive with no CAD history -- the status quo for every non-CAD body. Only meaningful when visual/collision is cad_mesh."
        },
        "mass": { "type": "number", "exclusiveMinimum": 0 },
        "inertia": {
          "type": "object",
          "required": ["ixx", "iyy", "izz"],
          "additionalProperties": false,
          "description": "Diagonal moments of inertia, kg*m^2. Off-diagonal products are out of scope for v0/v1.",
          "properties": {
            "ixx": { "type": "number", "exclusiveMinimum": 0 },
            "iyy": { "type": "number", "exclusiveMinimum": 0 },
            "izz": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 3,
              "maxItems": 4,
              "description": "RGB or RGBA, each channel 0..1"
            }
          }
        }
      }
    },
    "joint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "name", "type", "parent", "child"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "fixed" },
            "parent": { "type": "string" },
            "child": { "type": "string" },
            "origin": { "$ref": "#/definitions/transform" }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type", "parent", "child", "axis"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "hinge" },
            "parent": { "type": "string" },
            "child": { "type": "string" },
            "origin": { "$ref": "#/definitions/transform" },
            "axis": { "$ref": "#/definitions/vec3", "description": "rotation axis, unit vector, in the parent frame" },
            "limits": {
              "type": "object",
              "required": ["lower", "upper"],
              "additionalProperties": false,
              "properties": {
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            },
            "damping": { "type": "number", "minimum": 0 },
            "friction": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type", "parent", "child", "axis"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "slider" },
            "parent": { "type": "string" },
            "child": { "type": "string" },
            "origin": { "$ref": "#/definitions/transform" },
            "axis": { "$ref": "#/definitions/vec3", "description": "translation axis, unit vector, in the parent frame" },
            "limits": {
              "type": "object",
              "required": ["lower", "upper"],
              "additionalProperties": false,
              "properties": {
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            },
            "damping": { "type": "number", "minimum": 0 },
            "friction": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type", "parent", "child"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "ball" },
            "parent": { "type": "string" },
            "child": { "type": "string" },
            "origin": { "$ref": "#/definitions/transform" },
            "damping": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type", "parent", "child"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "free" },
            "parent": { "type": "string" },
            "child": { "type": "string" },
            "origin": { "$ref": "#/definitions/transform" }
          }
        }
      ]
    },
    "actuator": {
      "type": "object",
      "required": ["id", "name", "type", "target_joint"],
      "additionalProperties": false,
      "description": "Declares that a joint can be driven, and its limits. No gains/PID/target -- that is a controller's job (out of scope for v0/v1).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["motor", "servo", "force", "torque", "velocity"] },
        "target_joint": { "type": "string" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "effort": { "type": "number", "exclusiveMinimum": 0 },
            "velocity": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "required": ["id", "name", "type", "body"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["camera", "distance", "lidar", "imu", "encoder", "gps", "touch", "force_torque"] },
        "body": { "type": "string" },
        "joint": { "type": "string", "description": "required when type=encoder: which joint it reads" },
        "transform": { "$ref": "#/definitions/transform", "description": "mount offset within body's frame" },
        "params": {
          "type": "object",
          "description": "Type-specific parameters (e.g. camera resolution, lidar ray count/FOV). Envelope only -- full per-type validation lives in the hand-written validators, not here."
        }
      }
    }
  }
}
