{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "okrobo:world:v1",
  "title": "OKROBO World Definition v1",
  "description": "v0 plus coloured obstacles, which give the camera something to see and computer-vision lessons something to find. A v0 world is a valid v1 world with no obstacles. Units: meters, radians.",
  "type": "object",
  "required": ["name", "arena_width", "arena_height", "robot_radius", "wheel_base", "start"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "arena_width": { "type": "number", "exclusiveMinimum": 0 },
    "arena_height": { "type": "number", "exclusiveMinimum": 0 },
    "robot_radius": { "type": "number", "exclusiveMinimum": 0 },
    "wheel_base": { "type": "number", "exclusiveMinimum": 0 },
    "start": {
      "type": "object",
      "required": ["x", "y", "theta"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "theta": { "type": "number" }
      }
    },
    "obstacles": {
      "type": "array",
      "maxItems": 16,
      "description": "Axis-aligned coloured boxes. Visible to the distance sensor, lidar and camera.",
      "items": {
        "type": "object",
        "required": ["x", "y"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "label": { "type": "string", "description": "Optional name for lessons." }
        }
      }
    }
  }
}
