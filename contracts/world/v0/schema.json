{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "okrobo:world:v0",
  "title": "OKROBO World Definition v0",
  "description": "A world file as shipped in packs (e.g. packs/core/worlds/arena.json). Units: meters, radians. The robot must fit: 2 * robot_radius < min(arena_width, arena_height).",
  "type": "object",
  "required": ["name", "arena_width", "arena_height", "robot_radius", "wheel_base", "start"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "arena_width": { "type": "number", "exclusiveMinimum": 0 },
    "arena_height": { "type": "number", "exclusiveMinimum": 0 },
    "robot_radius": { "type": "number", "exclusiveMinimum": 0 },
    "wheel_base": { "type": "number", "exclusiveMinimum": 0 },
    "start": {
      "type": "object",
      "required": ["x", "y", "theta"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "theta": { "type": "number" }
      }
    }
  }
}
