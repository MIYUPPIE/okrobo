{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "okrobo:pack:v0",
  "title": "OKROBO Pack Manifest v0",
  "description": "pack.json at the root of a pack directory or archive. A pack ships worlds, robots (URDF), and lessons. The core pack is installed with the app; others download from the asset store or a school server and then work offline forever.",
  "type": "object",
  "required": ["id", "name", "version", "contents"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier, lowercase kebab-case.",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Semantic version, major.minor.patch.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requires": {
      "type": "object",
      "description": "Minimum studio version and pack dependencies.",
      "additionalProperties": false,
      "properties": {
        "studio": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "packs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": {
      "type": "string",
      "description": "Digest of the pack archive, verified after download.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contents": {
      "type": "object",
      "description": "Paths are relative to the pack root.",
      "additionalProperties": false,
      "properties": {
        "worlds": { "type": "array", "items": { "type": "string" } },
        "robots": { "type": "array", "items": { "type": "string" } },
        "lessons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
