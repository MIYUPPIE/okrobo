{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "okrobo-studio",
  "mainBinaryName": "okrobo-studio",
  "version": "0.1.0",
  "identifier": "com.okhub.robotics-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OKHUB Robotics Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "resources": {
      "../../../runtime/python/okrobo": "runtime-python/okrobo",
      "../../../runtime/python/.deps": "runtime-python/.deps",
      "runtime-dist": "runtime-dist",
      "../../../firmware/okrobo_car": "firmware/okrobo_car"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
